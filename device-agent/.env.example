AMBER_AGENT_ENV=development
AMBER_AGENT_API_BASE_URL=http://localhost:8000
AMBER_AGENT_API_KEY=replace-me
AMBER_AGENT_SYNC_BATCH_SIZE=100
AMBER_AGENT_SYNC_BASE_BACKOFF_SECONDS=2
AMBER_AGENT_SYNC_MAX_BACKOFF_SECONDS=300
AMBER_AGENT_HEARTBEAT_INTERVAL_SECONDS=30
AMBER_AGENT_DB_PATH=/var/lib/amber-agent/agent.db
